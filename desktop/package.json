{
  "name": "toolbox-desktop",
  "private": true,
  "version": "2026.11.26",
  "description": "AndroidTVTestToolBox Electron shell",
  "author": "AndroidTVTestToolBox",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,vite,electron -c cyan,green,magenta \"npm:dev:api\" \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:api": "node ./scripts/run-api.cjs --reload",
    "dev:electron": "wait-on http://127.0.0.1:17831/health http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER=http://127.0.0.1:5173 TOOLBOX_API_URL=http://127.0.0.1:17831 electron .",
    "dev:ui": "concurrently -k -n vite,electron -c green,magenta \"npm:dev:vite\" \"npm:dev:electron\"",
    "build": "vite build",
    "pack": "vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win dir",
    "dist:nsis": "vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis --publish never",
    "preview": "vite preview"
  },
  "build": {
    "extends": "electron-builder.yml"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.3.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^4.0.1",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
